# Copie para .env.local (ignorado pelo Git) e preencha com o projeto Supabase da CRED.
# Supabase → Project Settings → API Keys (e Data API para a URL).

# Project URL, ex.: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Chave PÚBLICA: "anon" (legada) ou "publishable" (sb_publishable_...).
# NUNCA use aqui a service_role nem uma chave sb_secret_... — tudo que começa com VITE_ vai para o navegador.
VITE_SUPABASE_ANON_KEY=

# Opcional: domínio público usado em "Copiar meu link de apresentação".
# Vazio → usa o endereço onde o painel está aberto. Ex.: https://apresentacao.credmhs.com.br
VITE_PUBLIC_SITE_URL=
